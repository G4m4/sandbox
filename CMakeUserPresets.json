{
  "version": 3,
  "configurePresets": [
    {
      "name": "local",
      "cacheVariables": {
        "CMAKE_VERBOSE_MAKEFILE": "ON"
      }
    },
    {
      "name": "local-clang-cl",
      "inherits": [
        "local",
        "x64",
        "windows-clang"
      ]
    },
    {
      "name": "local-android",
      "inherits": [
        "local",
        "android"
      ],
      "cacheVariables": {
        "SANDBOX_BUILD_ANDROID": "ON",
        // e.g android-35
        "ANDROID_PLATFORM": "ANDROID_VERSION",
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
        // e.g. "C:/Users/USERNAME/AppData/Local/Android/Sdk/ndk/29.0.14206865/build/cmake/android.toolchain.cmake"
        "CMAKE_TOOLCHAIN_FILE": "PATH_TO_ANDROID_NDK/NDK_VERSION/build/cmake/android.toolchain.cmake"
      },
      "environment": {
        // e.g. C:/Program Files/Android/Android Studio/jbr
        "JAVA_HOME": "JAVA_RUNTIME_PATH"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-clang-cl",
      "configurePreset": "local-clang-cl"
    },
    {
      "name": "local-android",
      "configurePreset": "local-android"
    }
  ]
}
